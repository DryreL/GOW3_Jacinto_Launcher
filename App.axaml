<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JacintoLauncher.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme/>
    <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource InkBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>

    <!-- Type -->
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LetterSpacing" Value="1"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LetterSpacing" Value="1.5"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock.status"><Setter Property="Foreground" Value="{DynamicResource StatusBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock.status.error"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,16,0"/></Style>

    <!-- Layout: one card style and one row rhythm for every settings page. -->
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style Selector="Grid.row"><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="MinHeight" Value="36"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="3"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="3"/></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="34"/></Style>
    <Style Selector="Slider"><Setter Property="VerticalAlignment" Value="Center"/></Style>

    <!-- Buttons -->
    <Style Selector="Button"><Setter Property="CornerRadius" Value="3"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FieldHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentDisabledBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentDisabledTextBrush}"/></Style>
    <Style Selector="Button.play"><Setter Property="MinHeight" Value="52"/><Setter Property="FontSize" Value="15"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource DisabledBrush}"/><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/></Style>

    <!-- Sidebar navigation -->
    <Style Selector="ToggleButton.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Background" Value="{DynamicResource HoverClearBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="ToggleButton.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.nav:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.nav:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FieldHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/><Setter Property="Foreground" Value="White"/></Style>

    <Style Selector="ToggleButton.nav:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverClearBrush}"/><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/></Style>

    <!-- Warning action: Uninstall. -->
    <Style Selector="Button.warn"><Setter Property="Background" Value="#C8641E"/><Setter Property="BorderBrush" Value="#C8641E"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.warn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.warn:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#DE7A2F"/><Setter Property="BorderBrush" Value="#DE7A2F"/><Setter Property="Foreground" Value="White"/></Style>

    <!-- FAQ -->
    <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="CornerRadius" Value="4"/></Style>

    <!-- Slider: visible track on the dark card. -->
    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton"><Setter Property="Background" Value="{DynamicResource LineBrush}"/></Style>

    <!-- Links: credits nicknames and the version number -->
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="20"/><Setter Property="Padding" Value="0,0,6,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>

    <!-- The version next to JACINTO: a box in the theme colour that opens the changelog. -->
    <Style Selector="Button.badge"><Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="7,1"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.badge:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.badge:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/><Setter Property="Foreground" Value="White"/></Style>

    <!-- Theme colour swatches -->
    <Style Selector="Button.swatch"><Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="13"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{TemplateBinding Background}"/><Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="Button.swatch.selected"><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Style>

    <!-- Key list -->
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="40"/><Setter Property="CornerRadius" Value="3"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource FieldBrush}"/></Style>
    <Style Selector="Border.keycap"><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="10,4"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>

    <!-- Keyboard and gamepad focus looks like hover. -->
    <Style Selector="CheckBox:focus-visible"><Setter Property="Background" Value="{DynamicResource FieldHoverBrush}"/></Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#Background"><Setter Property="Background" Value="{DynamicResource FieldHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="CheckBox"><Setter Property="CornerRadius" Value="3"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="ListBoxItem:selected:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="ToggleButton.nav:checked:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Style>

    <!-- Motion: short, and only when something changes, so an idle launcher draws nothing. -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12"/><BrushTransition Property="BorderBrush" Duration="0:0:0.12"/></Transitions></Setter></Style>
    <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12"/></Transitions></Setter></Style>
    <Style Selector="Button, ToggleButton"><Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/></Transitions></Setter></Style>
    <Style Selector="Button:pressed, ToggleButton:pressed"><Setter Property="RenderTransform" Value="scale(0.97)"/></Style>
    <Style Selector="Border.overlay[IsVisible=True]"><Style.Animations><Animation Duration="0:0:0.16" Easing="CubicEaseOut"><KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame></Animation></Style.Animations></Style>
    <Style Selector="Border.overlay[IsVisible=True] > Border.card"><Style.Animations><Animation Duration="0:0:0.2" Easing="CubicEaseOut"><KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.95"/><Setter Property="ScaleTransform.ScaleY" Value="0.95"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame></Animation></Style.Animations></Style>

    <!-- The sidebar folds to its icons. -->
    <Style Selector="Border#Sidebar"><Setter Property="Width" Value="300"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut"/></Transitions></Setter></Style>
    <Style Selector="Border#Sidebar.collapsed"><Setter Property="Width" Value="78"/></Style>
    <Style Selector="Border#Sidebar > Grid"><Setter Property="Margin" Value="20,14,20,14"/></Style>
    <Style Selector="Border#Sidebar.collapsed > Grid"><Setter Property="Margin" Value="12,14,12,14"/></Style>
    <Style Selector="Border#Sidebar.collapsed :is(Control).full"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Border#Sidebar.collapsed DockPanel"><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style Selector="Image.logo"><Setter Property="Width" Value="60"/><Setter Property="Height" Value="60"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
    <Style Selector="Border#Sidebar.collapsed Image.logo"><Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/><Setter Property="Margin" Value="0"/></Style>
    <Style Selector="Border#Sidebar.collapsed ToggleButton.nav"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style Selector="Border#Sidebar.collapsed ToggleButton.nav StackPanel TextBlock"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Border#Sidebar.collapsed Button.play"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="44"/></Style>
    <Style Selector="Border#Sidebar.collapsed Button.play StackPanel TextBlock"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Button.collapse"><Setter Property="ZIndex" Value="1"/><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,0,-14"/><Setter Property="Background" Value="{DynamicResource HoverClearBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.collapse PathIcon"><Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/></Transitions></Setter></Style>
    <Style Selector="Border#Sidebar.collapsed Button.collapse"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style Selector="Border#Sidebar.collapsed Button.collapse PathIcon"><Setter Property="RenderTransform" Value="rotate(180deg)"/></Style>
  </Application.Styles>
</Application>
