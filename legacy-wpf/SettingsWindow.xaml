<Window x:Class="JacintoLauncher.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jacinto Launcher - Settings" Width="640" Height="590" MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#090909" Foreground="#F0F0F0">
 <Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#65191D"/><Setter Property="BorderBrush" Value="#7C2025"/><Setter Property="Foreground" Value="#E4E4E4"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,10,0,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#8D242A"/></Trigger></Style.Triggers></Style></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="SETTINGS" FontSize="22" FontWeight="Bold"/><TextBlock Text="Launcher diagnostics and local data" Foreground="#A3A6AC" Margin="0,4,0,22"/><Border Background="#111111" BorderBrush="#292929" BorderThickness="1" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="PLAYER" Foreground="#A3A6AC" FontSize="12"/><TextBlock Text="PLAYER NAME" Foreground="#A3A6AC" FontSize="11" Margin="0,10,0,3"/><TextBox x:Name="PlayerNameBox" MaxLength="32"/><TextBlock Text="Shown in the launcher only; it does not modify Steam or game-account identity." Foreground="#A3A6AC" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="LAUNCHER LANGUAGE" Foreground="#A3A6AC" FontSize="11" Margin="0,14,0,3"/><ComboBox x:Name="LanguageBox" Width="240" HorizontalAlignment="Left"/><TextBlock Text="Changes the launcher only; the game language is not modified." Foreground="#A3A6AC" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
  <Border Background="#111111" BorderBrush="#292929" BorderThickness="1" Padding="16"><StackPanel><CheckBox x:Name="SkipIntroCheck" Content="Skip Intro" Foreground="#F0F0F0" Margin="0,8,0,8" Click="SkipIntro_Click"/><Button Content="Save Settings" Click="SavePaths_Click"/><Button Content="Create Desktop Shortcut" Click="Shortcut_Click"/><Button Content="Open Diagnostics" Click="Diagnostics_Click"/><TextBlock x:Name="GamePathText" TextWrapping="Wrap" Foreground="#A3A6AC" Margin="0,10,0,0"/></StackPanel></Border>
  <Border Background="#111111" BorderBrush="#292929" BorderThickness="1" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="SAVE MANAGEMENT" Foreground="#E3343B" FontSize="15" FontWeight="Bold"/><TextBlock Text="Backs up checkpoints and the profile with SHA-256 verification. Offline and Steam use the same saves." TextWrapping="Wrap" Foreground="#C8C8C8" Margin="0,8,0,0"/><Button Content="Create Save Backup" HorizontalAlignment="Left" Click="Backup_Click"/><TextBlock x:Name="BackupStatusText" Foreground="#A3A6AC" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>

  <TextBlock Text="Created by Refresh" FontSize="11" Foreground="#A3A6AC" HorizontalAlignment="Right" Margin="0,18,0,0" />
 </StackPanel></ScrollViewer>
</Window>
