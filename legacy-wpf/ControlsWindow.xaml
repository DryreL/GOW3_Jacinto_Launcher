<Window x:Class="JacintoLauncher.ControlsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jacinto Launcher - Controls" Width="720" Height="720" MinWidth="620" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#090909" Foreground="#F0F0F0">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#65191D"/><Setter Property="BorderBrush" Value="#7C2025"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#8D242A"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ListView"><Setter Property="Background" Value="#101010"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="BorderBrush" Value="#333333"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0"><TextBlock Text="CONTROLS" FontSize="22" FontWeight="Bold"/><TextBlock Text="Keyboard and mouse bindings supported by the Multipatch editor. Gamepad bindings are preserved." Foreground="#A3A6AC" TextWrapping="Wrap" Margin="0,4,0,14"/><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Mouse Sensitivity" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="SensitivityBox" Width="90" Background="#101010" Foreground="#F0F0F0" BorderBrush="#65191D"/><TextBlock Text="1–200 · blank leaves unchanged" Foreground="#A3A6AC" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="SensitivityStatus" Foreground="#D35B60" TextWrapping="Wrap" Margin="0,0,0,8"/></StackPanel>
  <ListView x:Name="BindingsList" Grid.Row="1" SelectionMode="Single"><ListView.View><GridView><GridViewColumn Header="Action" DisplayMemberBinding="{Binding Action}" Width="360"/><GridViewColumn Header="Key" DisplayMemberBinding="{Binding Key}" Width="180"/></GridView></ListView.View></ListView>
  <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#D35B60" TextWrapping="Wrap" Margin="0,10,0,12"/>
  <DockPanel Grid.Row="3"><Button Content="Change key" Click="Change_Click"/><Button Content="Restore defaults" Click="Defaults_Click"/><Button Content="Apply" Click="Apply_Click"/><Button Content="Rollback controls" Click="Rollback_Click"/><Button Content="Close" Click="Close_Click" DockPanel.Dock="Right" Margin="0"/></DockPanel>
 </Grid>
</Window>
