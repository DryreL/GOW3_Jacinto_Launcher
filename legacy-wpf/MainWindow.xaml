<Window x:Class="JacintoLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gears of War 3: Jacinto - Launcher" Width="1360" Height="850" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#030303" Foreground="White">
 <Window.Resources>
  <Style x:Key="PlayButton" TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Height" Value="54"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Background" Value="#65191D"/><Setter Property="BorderBrush" Value="#65191D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#491216"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#321114"/><Setter Property="BorderBrush" Value="#6C252A"/><Setter Property="Foreground" Value="#C6A8AA"/><Setter Property="Opacity" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#8D242A"/><Setter Property="BorderBrush" Value="#B13037"/></Trigger></Style.Triggers></Style>
  <Style x:Key="MenuButton" TargetType="Button"><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="0,0,0,0"/><Setter Property="Background" Value="#070707"/><Setter Property="BorderBrush" Value="#070707"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="FontSize" Value="16"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#141414"/><Setter Property="Foreground" Value="#E3343B"/></Trigger></Style.Triggers></Style>
  <Style x:Key="ChromeButton" TargetType="Button"><Setter Property="Width" Value="48"/><Setter Property="Background" Value="#050505"/><Setter Property="BorderBrush" Value="#050505"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#BCBCBC"/><Setter Property="FontSize" Value="16"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#65191D"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Background="#030303"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Background="#050505" MouseLeftButtonDown="TitleBar_Drag"><Image Source="assets/icon256.png" Width="24" Height="24" Margin="10,0,10,0"/><TextBlock Text="Gears of War 3: Jacinto - Launcher" VerticalAlignment="Center" Foreground="#CFCFCF"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="—" Style="{StaticResource ChromeButton}" Click="Minimize_Click"/><Button Content="×" Style="{StaticResource ChromeButton}" Click="Quit_Click"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Background="#111111" Margin="0,0,1,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="24,28,24,0"><DockPanel><Image Source="assets/disc.png" Width="58" Height="58" Stretch="UniformToFill" Margin="0,0,16,0"/><StackPanel><TextBlock Text="GEARS OF WAR 3" FontWeight="Bold" FontSize="16"/><TextBlock Text="JACINTO" Foreground="#E3343B" FontWeight="Bold" FontSize="16" Margin="0,5,0,0"/></StackPanel></DockPanel><Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Margin="0,26,0,24"/><TextBlock Text="SIGNED IN AS" Foreground="#A3A6AC" FontSize="12"/><TextBlock x:Name="PlayerNameText" Text="Player" FontWeight="Bold" FontSize="16" Margin="0,8,0,20"/>
     <Button x:Name="PlayOfflineButton" Content="Play Offline" Style="{StaticResource PlayButton}" Click="PlayOffline_Click"/><Button x:Name="PlaySteamButton" Content="Play on Steam  ·  Coming soon" Style="{StaticResource PlayButton}" IsEnabled="False" ToolTip="Steam/JacintoNet is not prepared for launch." Click="PlaySteam_Click"/>
     <TextBlock Text="MENU" Foreground="#A3A6AC" FontSize="12" Margin="0,25,0,10"/><Button Content="Game Settings" Style="{StaticResource MenuButton}" Click="GameSettings_Click"/><Button Content="Controls" Style="{StaticResource MenuButton}" Click="Controls_Click"/><Button Content="Settings" Style="{StaticResource MenuButton}" Click="Settings_Click"/></StackPanel>
    <Button Grid.Row="2" Content="Quit" Style="{StaticResource MenuButton}" Margin="22,0,22,22" Click="Quit_Click"/>
   </Grid>
   <Grid Grid.Column="1" Background="#000000"><Image Source="assets/bg.png" Stretch="UniformToFill"/><Grid VerticalAlignment="Bottom" Margin="34,0,34,24"><StackPanel><TextBlock x:Name="StatusText" FontSize="16"/><TextBlock x:Name="PathText" Foreground="#D35B60" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#A3A6AC"/></Grid></Grid>
  </Grid>
 </Grid>
</Window>
