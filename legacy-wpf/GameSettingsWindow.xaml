<Window x:Class="JacintoLauncher.GameSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jacinto Launcher - Game Settings" Width="760" Height="780" MinWidth="650" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#090909" Foreground="#F0F0F0">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#65191D"/><Setter Property="BorderBrush" Value="#7C2025"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#8D242A"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#171717"/><Setter Property="Foreground" Value="#111111"/><Setter Property="MinWidth" Value="180"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#171717"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="BorderBrush" Value="#454545"/><Setter Property="Padding" Value="6"/><Setter Property="MinWidth" Value="100"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E0E0E0"/><Setter Property="Margin" Value="0,4,18,4"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,12,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel Grid.IsSharedSizeScope="True">
   <TextBlock Text="GAME SETTINGS" FontSize="22" FontWeight="Bold"/><TextBlock Text="Edits Multipatch graphics.json and applies supported values to the game configuration and existing launchers." TextWrapping="Wrap" Foreground="#A3A6AC" Margin="0,4,0,18"/>
   <TextBlock Text="DISPLAY" Foreground="#E3343B" FontWeight="Bold" Margin="0,0,0,8"/>
   <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="190" MaxWidth="330" SharedSizeGroup="Label"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Resolution" Style="{StaticResource Label}"/><ComboBox x:Name="ResolutionBox" Grid.Column="1" IsEditable="True"><ComboBoxItem Content="native"/><ComboBoxItem Content="1280x720"/><ComboBoxItem Content="1600x900"/><ComboBoxItem Content="1920x1080"/><ComboBoxItem Content="2560x1440"/><ComboBoxItem Content="3840x2160"/><ComboBoxItem Content="2560x1080"/><ComboBoxItem Content="3440x1440"/><ComboBoxItem Content="5120x1440"/><ComboBoxItem Content="span"/></ComboBox>
    <TextBlock Grid.Row="1" Text="Display mode" Style="{StaticResource Label}"/><ComboBox x:Name="DisplayModeBox" Grid.Row="1" Grid.Column="1"><ComboBoxItem Content="Fullscreen"/><ComboBoxItem Content="Windowed"/></ComboBox>
    <TextBlock Grid.Row="2" Text="Frame rate limit (0 = Multipatch default)" Style="{StaticResource Label}"/><TextBox x:Name="FpsBox" Grid.Row="2" Grid.Column="1"/>
    <TextBlock Grid.Row="3" Text="Fullscreen refresh rate (0 = game default)" Style="{StaticResource Label}"/><TextBox x:Name="RefreshBox" Grid.Row="3" Grid.Column="1"/>
    <TextBlock Grid.Row="4" Text="Field of view (0 = automatic, 50–130)" Style="{StaticResource Label}"/><TextBox x:Name="FovBox" Grid.Row="4" Grid.Column="1"/>
    <CheckBox x:Name="VsyncCheck" Grid.Row="5" Grid.Column="1" Content="Vertical sync (VSync)"/>
   </Grid>
   <CheckBox x:Name="FovAllModesCheck" Content="Apply FOV to every camera mode"/>
   <TextBlock Text="GRAPHICS" Foreground="#E3343B" FontWeight="Bold" Margin="0,14,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="190" MaxWidth="330" SharedSizeGroup="Label"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Anti-aliasing" Style="{StaticResource Label}"/><ComboBox x:Name="AaBox" Grid.Column="1"><ComboBoxItem Content="Off"/><ComboBoxItem Content="FXAA / Temporal AA"/><ComboBoxItem Content="MSAA 2x"/><ComboBoxItem Content="MSAA 4x"/></ComboBox>
    <TextBlock Grid.Row="1" Text="Anisotropic filtering" Style="{StaticResource Label}"/><ComboBox x:Name="AnisotropyBox" Grid.Row="1" Grid.Column="1"><ComboBoxItem Content="1x"/><ComboBoxItem Content="2x"/><ComboBoxItem Content="4x"/><ComboBoxItem Content="8x"/><ComboBoxItem Content="16x"/></ComboBox>
    <TextBlock Grid.Row="2" Text="Graphics detail" Style="{StaticResource Label}"/><ComboBox x:Name="GraphicsQualityBox" Grid.Row="2" Grid.Column="1"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Ultra"/></ComboBox>
    <TextBlock Grid.Row="3" Text="Shadows" Style="{StaticResource Label}"/><ComboBox x:Name="ShadowQualityBox" Grid.Row="3" Grid.Column="1"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Ultra"/></ComboBox>
    <TextBlock Grid.Row="4" Text="Textures" Style="{StaticResource Label}"/><ComboBox x:Name="TextureQualityBox" Grid.Row="4" Grid.Column="1"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Ultra"/></ComboBox>
    <TextBlock Grid.Row="5" Text="Foliage" Style="{StaticResource Label}"/><ComboBox x:Name="FoliageQualityBox" Grid.Row="5" Grid.Column="1"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Ultra"/></ComboBox>
    <TextBlock Grid.Row="6" Text="Game storage drive" Style="{StaticResource Label}"/><ComboBox x:Name="DriveTypeBox" Grid.Row="6" Grid.Column="1"><ComboBoxItem Content="SSD / NVMe"/><ComboBoxItem Content="HDD"/></ComboBox>
   </Grid>
   <WrapPanel Margin="0,6,0,0"><CheckBox x:Name="AmbientOcclusionCheck" Content="Ambient occlusion"/><CheckBox x:Name="MotionBlurCheck" Content="Motion blur"/><CheckBox x:Name="DepthOfFieldCheck" Content="Depth of field"/><CheckBox x:Name="BloomCheck" Content="Bloom"/><CheckBox x:Name="LensFlaresCheck" Content="Lens flares"/><CheckBox x:Name="LightShaftsCheck" Content="Light shafts"/><CheckBox x:Name="DistortionCheck" Content="Distortion"/><CheckBox x:Name="RadialBlurCheck" Content="Radial blur"/><CheckBox x:Name="SubsurfaceCheck" Content="Subsurface scattering"/><CheckBox x:Name="SeparateTranslucencyCheck" Content="Separate translucency"/></WrapPanel>
   <TextBlock Text="AUDIO AND CAMERA" Foreground="#E3343B" FontWeight="Bold" Margin="0,14,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="190" MaxWidth="330" SharedSizeGroup="Label"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Audio channels" Style="{StaticResource Label}"/><ComboBox x:Name="AudioChannelsBox" Grid.Column="1"><ComboBoxItem Content="32 (original)"/><ComboBoxItem Content="64 (fewer sounds cut off in big fights)"/><ComboBoxItem Content="128"/></ComboBox>
    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"><CheckBox x:Name="AudioFilterCheck" Content="Audio filter (muffled sound behind walls / under water)" ToolTip="Turn off if sound randomly becomes muffled, underwater or far away."/><CheckBox x:Name="RunShakeCheck" Content="Camera shake while running (roadie run)"/></WrapPanel>
   </Grid>
   <TextBlock Text="MSAA is supported up to 4x by the Multipatch. Settings apply to existing INIs and startup scripts; restart the game after applying. Music and effects volume are in the game's own Options menu." TextWrapping="Wrap" Foreground="#A3A6AC" Margin="0,10,0,16"/>
  </StackPanel></ScrollViewer>
  <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#D35B60" TextWrapping="Wrap" Margin="0,10,0,12"/>
  <DockPanel Grid.Row="2"><Button Content="Apply settings" Click="Apply_Click"/><Button Content="Rollback last graphics change" Click="Rollback_Click"/><Button Content="Close" Click="Close_Click" DockPanel.Dock="Right" Margin="0"/></DockPanel>
 </Grid>
</Window>
